# Web Server Configuration
HOST=0.0.0.0
PORT=8080

# ComfyUI Engine Configuration
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_CLIENT_ID=comfy_web_app_client

# Mode: true for local dev simulator without active GPU ComfyUI, false for live ComfyUI
MOCK_MODE=true

# Model & Data Paths
DATABASE_PATH=data/tasks.sqlite
OUTPUT_DIR=output/full
THUMB_DIR=output/thumbs
MODELS_EXTRA_PATH=D:\MyAiModels\LibLib\Models

# Thermal & Batch Settings
COOLDOWN_BATCH_SIZE=30
COOLDOWN_SECONDS=15
FREE_MEMORY_BATCH_SIZE=50
